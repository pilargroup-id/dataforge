APP_NAME=
APP_SLUG=
APP_PORT=3000
NODE_ENV=development

# JWT - shared secret with pilargroup
JWT_SECRET=

# Internal Endpoint secret - shared secret with pilargroup
INTERNAL_SYNC_SECRET=

# Pilargroup base URL
PILARGROUP_URL=https://pilargroup.id

# CORS
CORS_ORIGIN=http://localhost:5173

# Database Project 
AUTH_ME_TIMEOUT_MS=10000


DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=replace_with_project_database

# Dev auth — auto-login using these credentials, token is still fetched from pilargroup
DEV_AUTH_ENABLED=true

# DEV_AUTH_USERNAME=
# DEV_AUTH_PASSWORD=
