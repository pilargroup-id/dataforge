APP_NAME=dataforge
APP_SLUG=dataforge
APP_PORT=3000
NODE_ENV=production

# Shared auth with PilarGroup
JWT_SECRET=
PILARGROUP_URL=https://pilargroup.id
AUTH_ME_TIMEOUT_MS=10000

# CORS
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dataforge
DB_CONNECTION_LIMIT=10

# Dataforge access
IT_DEPARTMENT_CODE=SIT

# Upload limits
MAX_FILES_PER_BATCH=20
MAX_FILE_SIZE_MB=200
MAX_BATCH_SIZE_MB=1024
MAX_OUTPUT_SIZE_MB=99

# Temporary/result storage
TEMP_STORAGE_PATH=storage/temp
RESULT_STORAGE_PATH=storage/results

# Result lifecycle
RESULT_EXPIRY_HOURS=6
DAILY_CLEANUP_CUTOFF=20:00
LAST_CONVERSION_START_TIME=19:30
CLEANUP_INTERVAL_MS=60000

# Pause/resume + archive finalization
PAUSED_EXPIRY_HOURS=48
ARCHIVE_TIMEOUT_MS=600000
